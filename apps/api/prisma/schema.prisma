// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Household {
  id          String            @id
  createdAt   DateTime          @default(now())
  items       InventoryItem[]
  recipes     Recipe[]
  suggestions MealSuggestion[]
  members     HouseholdMember[]
}

model InventoryItem {
  id             String    @id @default(uuid())
  householdId    String
  ingredientId   String
  quantity       Float
  expirationDate DateTime?

  household  Household  @relation(fields: [householdId], references: [id])
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@unique([householdId, ingredientId])
  @@index([householdId])
  @@index([ingredientId])
}

model Recipe {
  id          String @id
  householdId String
  name        String

  household   Household          @relation(fields: [householdId], references: [id])
  ingredients RecipeIngredient[]

  acceptedInSuggestions MealSuggestion[] @relation("AcceptedRecipe")

  @@index([householdId])
}

model RecipeIngredient {
  id           String @id @default(uuid())
  recipeId     String
  ingredientId String
  amount       Float

  recipe     Recipe     @relation(fields: [recipeId], references: [id])
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@index([recipeId])
  @@index([ingredientId])
}

enum SuggestionStatus {
  PROPUESTA
  ACEPTADA
  MODIFICADA
}

enum MealSlot {
  DESAYUNO
  COMIDA
  CENA
}

enum RecipePortion {
  FULL
  HALF
}

model MealSuggestion {
  id          String           @id @default(uuid())
  householdId String
  date        DateTime
  slot        MealSlot
  status      SuggestionStatus @default(PROPUESTA)

  acceptedRecipeId String?
  acceptedRecipe   Recipe? @relation("AcceptedRecipe", fields: [acceptedRecipeId], references: [id])
  acceptedPortion  RecipePortion @default(FULL)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  household Household              @relation(fields: [householdId], references: [id])
  recipes   MealSuggestionRecipe[]

  @@unique([householdId, date, slot])
  @@index([householdId, date])
}

model MealSuggestionRecipe {
  id           String @id @default(uuid())
  suggestionId String
  recipeId     String
  recipeName   String
  position     Int

  suggestion MealSuggestion @relation(fields: [suggestionId], references: [id])

  @@unique([suggestionId, position])
  @@unique([suggestionId, recipeId])
  @@index([suggestionId])
}

model Ingredient {
  id             String   @id @default(uuid())
  name           String
  normalizedName String
  category       String? // opcional
  createdAt      DateTime @default(now())

  // reverse relations
  inventoryItems    InventoryItem[]
  recipeIngredients RecipeIngredient[]

  @@unique([normalizedName])
  @@index([normalizedName])
}

enum HouseholdRole {
  OWNER
  MEMBER
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships HouseholdMember[]
}

model HouseholdMember {
  id          String        @id @default(uuid())
  userId      String
  householdId String
  role        HouseholdRole @default(MEMBER)
  createdAt   DateTime      @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([userId, householdId])
  @@index([userId])
  @@index([householdId])
}
